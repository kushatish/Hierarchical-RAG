# Export these variables in your shell; the app does not auto-load .env files.
RAG_BACKEND=lexical
RAG_GENERATOR=extractive
RAG_RERANK=false
# Optional: install requirements-ml.txt, then use sentence-transformers / gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# Set a nonempty key before exposing the API outside localhost.
# RAG_API_KEY=
# RAG_DB_PATH=/absolute/path/to/assistant.sqlite3

# Chunk sizes and budgets count words, not tokens.
RAG_PARENT_WORDS=240
RAG_CHILD_WORDS=60
RAG_OVERLAP_WORDS=12
RAG_TOP_K=5
RAG_CONTEXT_WORDS=1200
RAG_CACHE_THRESHOLD=0.97
RAG_CACHE_TTL=3600
RAG_CACHE_CAPACITY=1000

# Operational limits apply per worker; use shared controls for multiple replicas.
RAG_RATE_LIMIT=120
RAG_MAX_INFLIGHT=8
RAG_REQUIRE_API_KEY=false
# Pinned CPU alternative: pip install -r requirements-onnx.txt
# python -m core.onnx_models --download
# RAG_BACKEND=onnx
# RAG_MODEL_DIR=/absolute/path/to/model-cache
